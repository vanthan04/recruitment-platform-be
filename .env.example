PORT=8080
API_PREFIX=api/v1

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Matches docker-compose.yml's postgres service out of the box.
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruitment_platform?schema=public"
# Only used by `prisma migrate` (see prisma.config.ts's directUrl) — leave
# unset locally (docker-compose Postgres has no pooler). If DATABASE_URL
# points at a pooled connection (e.g. Neon's "-pooler" host, or any
# PgBouncer-fronted DB), set DIRECT_URL to that same DB's direct/unpooled
# connection string instead — Prisma Migrate needs a session-level advisory
# lock that transaction-mode pooling can't provide.
DIRECT_URL=

FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed browser origins for CORS (HTTP + WebSocket).
# Optional locally (falls back to reflecting any origin); REQUIRED when
# NODE_ENV=production — the app refuses to boot without it rather than
# silently allowing credentialed requests from any origin.
CORS_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:8080/api/v1/auth/facebook/callback

JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRATION=900000

JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_REFRESH_EXPIRATION=7d

# Optional: Upstash (or any ioredis-compatible) Redis connection string.
# Create a free database at https://console.upstash.com, open its "Redis
# Connect" tab and copy the ioredis URL (starts with rediss://). Used for
# distributed rate-limit storage across instances and per-account
# login-lockout tracking. Leave unset for local dev — the app falls back
# to in-memory (per-process) rate limiting and skips account lockout.
REDIS_URL=
LOGIN_LOCKOUT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# STORAGE_PROVIDER selects which class handles file-upload storage:
#   s3       -> S3StorageProvider (AWS S3 / LocalStack / MinIO / R2 — anything
#               speaking the S3 API, configured via the S3_* vars below)
#   supabase -> SupabaseStorageProvider (Supabase Storage, configured via the
#               SUPABASE_* vars further down)
STORAGE_PROVIDER=s3

# Used when STORAGE_PROVIDER=s3. Values below match docker-compose.yml's
# LocalStack service for local dev out of the box.
S3_REGION=ap-southeast-1
S3_BUCKET=recruitment-platform-local
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_ENDPOINT=http://localhost:4567
S3_FORCE_PATH_STYLE=true
# Alternative for a real deployment without an AWS S3 bucket: Cloudflare R2
# (10GB free, zero egress fee). Get these from the Cloudflare dashboard >
# R2 > Manage R2 API Tokens:
#   S3_REGION=auto
#   S3_BUCKET=<bucket name you create in R2>
#   S3_ACCESS_KEY=<R2 API token access key id>
#   S3_SECRET_KEY=<R2 API token secret access key>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=true

# Used when STORAGE_PROVIDER=supabase. Get these from Project Settings >
# Storage > S3 Connection in the Supabase dashboard.
SUPABASE_PROJECT_REF=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_PUBLIC_URL_BASE=

LOG_LEVEL=debug  # fatal/error/warn/info/debug/trace/silent

# AI Recruitment Agent ("Find Matching CVs", see src/ai). Optional: the app
# boots without AI_API_KEY set, but /jobs/:id/matching-candidates and CV
# analysis fail at call time until a real key is provided.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_API_KEY=
AI_MAX_CANDIDATES=30
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT_MS=30000
AI_ANALYSIS_BATCH_SIZE=20
