PORT=8080
API_PREFIX=api/v1

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Matches docker-compose.yml's postgres service out of the box.
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruitment_platform?schema=public"

# Comma-separated allowed origins; omit to reflect any origin (dev-friendly default).
# CORS_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRATION=900000

JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_REFRESH_EXPIRATION=7d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# S3 file storage
S3_REGION=ap-southeast-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=  # set for S3-compatible providers (e.g. MinIO, R2)

# LOG_LEVEL=debug  # fatal/error/warn/info/debug/trace/silent
