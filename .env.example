PORT=8080
API_PREFIX=api/v1

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Matches docker-compose.yml's postgres service out of the box.
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruitment_platform?schema=public"

# Comma-separated allowed origins; omit to reflect any origin (dev-friendly default).
# CORS_ORIGIN=http://localhost:3000

# Where the frontend runs — used to build the redirect URL after a Google/
# Facebook login (defaults to http://localhost:3000 if omitted).
FRONTEND_URL=http://localhost:3000

# Google/Facebook login (optional — leave blank and those two login buttons
# just redirect to a "not configured" error; nothing else in the app is
# affected). Get these from:
#   Google:   https://console.cloud.google.com/apis/credentials
#   Facebook: https://developers.facebook.com/apps ("Facebook Login" product)
# Authorized/callback redirect URI must match *_CALLBACK_URL exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:8080/api/v1/auth/facebook/callback

JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRATION=900000

JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_REFRESH_EXPIRATION=7d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=your-email@gmail.com

# S3 file storage. Defaults below match this repo's docker-compose LocalStack
# service, so uploads work out of the box for local dev. For real AWS, set
# your bucket/credentials and remove S3_ENDPOINT + S3_FORCE_PATH_STYLE.
S3_REGION=ap-southeast-1
S3_BUCKET=recruitment-platform-local
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_ENDPOINT=http://localhost:4567
S3_FORCE_PATH_STYLE=true

# LOG_LEVEL=debug  # fatal/error/warn/info/debug/trace/silent
