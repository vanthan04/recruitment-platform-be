# Copy to .env.test (gitignored, same as .env) before running `npm run test:e2e`.
# Only DATABASE_URL needs to differ from .env — every other var (JWT
# secrets, mail, S3) falls back to .env automatically. Point this at a
# different database name on the same docker-compose postgres service;
# `npm run test:e2e` creates it automatically via `prisma db push` if it
# doesn't exist yet.
DATABASE_URL="postgresql://postgres:password@localhost:5432/recruitment_platform_test?schema=public"
