{
  "family": "recruitment-platform-be",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<account-id>:role/<ecs-task-execution-role>",
  "taskRoleArn": "arn:aws:iam::<account-id>:role/<ecs-task-role>",
  "containerDefinitions": [
    {
      "name": "recruitment-platform-be",
      "image": "<ecr-repository-uri>:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/api/v1/healthcheck || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "API_PREFIX", "value": "api/v1" },
        { "name": "CORS_ORIGIN", "value": "<comma-separated allowed origins, e.g. https://your-frontend-domain.com>" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "JWT_EXPIRATION", "value": "900000" },
        { "name": "JWT_REFRESH_EXPIRATION", "value": "7d" },
        { "name": "S3_REGION", "value": "<aws-region, e.g. ap-southeast-1>" },
        { "name": "AWS_REGION", "value": "<aws-region, e.g. ap-southeast-1>" },
        { "name": "RATE_LIMIT_TABLE", "value": "<dynamodb-table-name>" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "JWT_REFRESH_SECRET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "MAIL_HOST", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "MAIL_PORT", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "MAIL_USER", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "MAIL_PASS", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "MAIL_FROM", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "S3_BUCKET", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "S3_ACCESS_KEY", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" },
        { "name": "S3_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:<region>:<account-id>:secret:<name>" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/recruitment-platform-be",
          "awslogs-region": "<aws-region, e.g. ap-southeast-1>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
