generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CvStatus {
  DRAFT
  PUBLISHED
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS
}

enum JobLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  MANAGER
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
}

// ─────────────────────────────────────────────
// User & Profile
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  password     String
  verifyCode   String?
  role         UserRole   @default(CANDIDATE)
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  profile      Profile?

  // Relations
  cvs             Cv[]
  jobs             Job[]             // Only for RECRUITER
  applications     JobApplication[]
  bookmarks        Bookmark[]
  company          Company?          @relation(fields: [companyId], references: [id])
  companyId        String?
  ownedCompanies   Company[]         @relation("CompanyOwner")
  notifications    Notification[]
  savedSearches    SavedSearch[]
  refreshTokens    RefreshToken[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Company Module
// ─────────────────────────────────────────────

model Company {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  logoUrl     String?
  description String?
  website     String?
  industry    String?
  size        CompanySize?
  address     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relations
  owner       User         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  recruiters  User[]
  jobs        Job[]

  @@map("companies")
}

model Profile {
  id          String    @id @default(uuid())
  fullName    String
  headline    String?   // e.g. "Senior Frontend Developer"
  summary     String?   // Brief bio / about me
  birthDate   DateTime?
  gender      Gender?
  phoneNumber String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @unique

  @@map("user_profiles")
}

// ─────────────────────────────────────────────
// CV Module
// ─────────────────────────────────────────────

model Cv {
  id          String   @id @default(uuid())
  title       String
  summary     String?
  fileUrl     String?
  status      CvStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  experiences  Experience[]
  educations   Education[]
  skills       Skill[]
  applications JobApplication[]

  @@index([userId])
  @@map("cvs")
}

model Experience {
  id          String    @id @default(uuid())
  company     String
  position    String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId String

  @@map("experiences")
}

model Education {
  id          String    @id @default(uuid())
  school      String
  degree      String
  fieldOfStudy String?
  description String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId String

  @@map("educations")
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  level     String?  // e.g. "Beginner", "Intermediate", "Advanced", "Expert"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cv   Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId String

  @@map("skills")
}

// ─────────────────────────────────────────────
// Category Module
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs Job[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// Job Module
// ─────────────────────────────────────────────

model Job {
  id          String    @id @default(uuid())
  title       String
  description String
  location    String
  jobType     JobType   @default(FULL_TIME)
  level       JobLevel?
  status      JobStatus @default(DRAFT)
  viewCount   Int       @default(0)
  salaryMin   Int?
  salaryMax   Int?
  currency    String    @default("VND")
  requirements String?
  benefits    String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  postedBy     User             @relation(fields: [postedById], references: [id], onDelete: Cascade)
  postedById   String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?
  applications JobApplication[]
  bookmarks    Bookmark[]

  @@index([postedById])
  @@index([companyId])
  @@index([categoryId])
  @@map("jobs")
}

// ─────────────────────────────────────────────
// Job Application Module
// ─────────────────────────────────────────────

model JobApplication {
  id          String            @id @default(uuid())
  status      ApplicationStatus @default(PENDING)
  coverLetter String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  cv     Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId   String

  @@unique([userId, jobId]) // One application per user per job
  @@index([jobId])
  @@map("job_applications")
}

// ─────────────────────────────────────────────
// Bookmark Module
// ─────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String

  @@unique([userId, jobId]) // One bookmark per user per job
  @@index([jobId])
  @@map("bookmarks")
}

// ─────────────────────────────────────────────
// Notification Module
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Job Alert Module
// ─────────────────────────────────────────────

model SavedSearch {
  id         String    @id @default(uuid())
  keyword    String?
  location   String?
  categoryId String?
  jobType    JobType?
  createdAt  DateTime  @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("saved_searches")
}

// ─────────────────────────────────────────────
// Refresh Token (multi-device sessions)
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("refresh_tokens")
}
