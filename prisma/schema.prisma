generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CvStatus {
  DRAFT
  PUBLISHED
}

enum CvFileType {
  PDF
  DOC
  DOCX
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_500
  SIZE_500_PLUS
}

enum CompanyType {
  PRODUCT
  OUTSOURCING
  STARTUP
  CONSULTING
}

enum JobLevel {
  INTERN
  FRESHER
  JUNIOR
  MIDDLE
  SENIOR
  MANAGER
}

enum NotificationType {
  NEW_APPLICATION
  APPLICATION_STATUS_CHANGED
  NEW_MESSAGE
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum ChatParticipantRole {
  CANDIDATE
  RECRUITER
}

enum InterviewStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ─────────────────────────────────────────────
// RBAC Module (database-driven authorization)
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  createdAt DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// User & Profile
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  // Nullable — social-login users (Google/Facebook) never set one.
  password     String?
  // Social login linkage. Nullable/unique so a local account can later link
  // one or both providers, and a provider id never resolves to two users.
  googleId     String?    @unique
  facebookId   String?    @unique
  // roleId/roleRef is the single source of truth for a user's role (the
  // former legacy `role` enum column + DB trigger have been removed —
  // application code derives the role name from `roleRef.name` instead).
  roleRef      Role       @relation(fields: [roleId], references: [id])
  roleId       String
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  profile      Profile?

  // Relations
  cvs             Cv[]
  jobs             Job[]             // Only for RECRUITER
  applications     JobApplication[]
  bookmarks        Bookmark[]
  company          Company?          @relation(fields: [companyId], references: [id])
  companyId        String?
  ownedCompanies   Company[]         @relation("CompanyOwner")
  notifications    Notification[]
  savedSearches    SavedSearch[]
  refreshTokens    RefreshToken[]
  scheduledInterviews InterviewSchedule[]
  applicationStatusChanges ApplicationStatusHistory[]
  oauthLoginCodes     OauthLoginCode[]
  verificationTokens  VerificationToken[]
  conversationsAsCandidate  Conversation[]       @relation("ConversationCandidate")
  conversationsAsRecruiter  Conversation[]       @relation("ConversationRecruiter")
  conversationMemberships   ConversationMember[]
  sentMessages              Message[]

  @@map("users")
}

// ─────────────────────────────────────────────
// Company Module
// ─────────────────────────────────────────────

model Company {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  logoUrl     String?
  description String?
  website     String?
  size        CompanySize?
  companyType CompanyType?
  address     String?
  province    String?
  ward        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relations
  owner       User         @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  // "1 active company per recruiter" is enforced by a partial unique index
  // (`ownerId` WHERE `deletedAt IS NULL`), not a plain `@unique` here — a
  // recruiter is allowed to create a new company after soft-deleting the
  // old one, and Prisma's DSL can't express that condition. See raw-SQL
  // migration 20260905090000_company_owner_active_unique.
  ownerId     String
  recruiters  User[]
  jobs        Job[]

  @@map("companies")
}

model Profile {
  id          String    @id @default(uuid())
  fullName    String
  headline    String?   // e.g. "Senior Frontend Developer"
  summary     String?   // Brief bio / about me
  birthDate   DateTime?
  gender      Gender?
  phoneNumber String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @unique

  @@map("user_profiles")
}

// ─────────────────────────────────────────────
// CV Module — file-only (upload/download), no CV builder.
// ─────────────────────────────────────────────

model Cv {
  id           String     @id @default(uuid())
  title        String

  // Original file metadata (what the candidate sees / downloads as)
  originalName String
  fileType     CvFileType
  mimeType     String
  fileSize     Int?

  // S3 object identifier — backend-generated, never derived from originalName
  fileKey      String

  status       CvStatus   @default(PUBLISHED)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  applications JobApplication[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([userId])
  @@map("cvs")
}

// ─────────────────────────────────────────────
// Category Module
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobs Job[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// Job Module
// ─────────────────────────────────────────────

model Job {
  id             String         @id @default(uuid())
  title          String
  description    String
  location       String
  employmentType EmploymentType @default(FULL_TIME)
  workMode       WorkMode       @default(ONSITE)
  level       JobLevel?
  status      JobStatus @default(DRAFT)
  viewCount   Int       @default(0)
  salaryMin   Int?
  salaryMax   Int?
  currency    String    @default("VND")
  requirements String?
  benefits    String?
  workingHours String?
  applicationMethod String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  postedBy     User             @relation(fields: [postedById], references: [id], onDelete: Cascade)
  postedById   String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?
  applications JobApplication[]
  bookmarks    Bookmark[]
  conversations Conversation[]
  skills       JobSkill[]

  @@index([postedById])
  @@index([companyId])
  @@index([categoryId])
  @@index([status, createdAt])
  @@index([companyId, status])
  @@index([categoryId, status])
  @@index([status, expiresAt])
  @@map("jobs")
}

// ─────────────────────────────────────────────
// Job Skills (structured, admin-managed taxonomy)
// ─────────────────────────────────────────────

model Skill {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  jobs      JobSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

// ─────────────────────────────────────────────
// Job Application Module
// ─────────────────────────────────────────────

model JobApplication {
  id          String            @id @default(uuid())
  status      ApplicationStatus @default(APPLIED)
  coverLetter String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String
  cv     Cv     @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvId   String
  conversation Conversation?
  interviewSchedules InterviewSchedule[]
  statusHistory ApplicationStatusHistory[]

  @@unique([userId, jobId]) // One application per user per job
  @@index([jobId])
  @@index([jobId, status])
  @@index([userId, createdAt])
  @@map("job_applications")
}

// ─────────────────────────────────────────────
// Application Status History
// ─────────────────────────────────────────────

model ApplicationStatusHistory {
  id         String             @id @default(uuid())
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  note       String?
  createdAt  DateTime           @default(now())

  application   JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  changedBy     User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById   String?

  @@index([applicationId, createdAt])
  @@map("application_status_histories")
}

// ─────────────────────────────────────────────
// Interview Module
// ─────────────────────────────────────────────

model InterviewSchedule {
  id              String           @id @default(uuid())
  scheduledAt     DateTime
  durationMinutes Int?
  location        String?
  meetingLink     String?
  note            String?
  status          InterviewStatus  @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  jobApplicationId String
  createdBy        User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById      String

  @@index([jobApplicationId])
  @@index([jobApplicationId, scheduledAt])
  @@map("interview_schedules")
}

// ─────────────────────────────────────────────
// Bookmark Module
// ─────────────────────────────────────────────

model Bookmark {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId  String

  @@unique([userId, jobId]) // One bookmark per user per job
  @@index([jobId])
  @@map("bookmarks")
}

// ─────────────────────────────────────────────
// Notification Module
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// Job Alert Module
// ─────────────────────────────────────────────

model SavedSearch {
  id             String          @id @default(uuid())
  keyword        String?
  location       String?
  categoryId     String?
  employmentType EmploymentType?
  workMode       WorkMode?
  createdAt      DateTime        @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("saved_searches")
}

// ─────────────────────────────────────────────
// Refresh Token (multi-device sessions)
// ─────────────────────────────────────────────

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// OAuth login handoff (Google/Facebook)
// ─────────────────────────────────────────────

// Short-lived, single-use code the OAuth callback redirects the browser
// with instead of the actual JWTs — keeps access/refresh tokens out of the
// redirect URL (browser history, Referer headers, server logs). The
// frontend exchanges it server-side for the real tokens within 60s.
// The code identifies *who* logged in — access/refresh JWTs are minted
// fresh at exchange time (reusing AuthService.getTokens()), never
// pre-generated and stored here in plaintext.
model OauthLoginCode {
  id        String    @id @default(uuid())
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@map("oauth_login_codes")
}

// ─────────────────────────────────────────────
// Email verification / password reset tokens
// ─────────────────────────────────────────────

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Replaces the old plaintext User.verifyCode, which email verification AND
// password reset both wrote to the same column — a code emailed for one
// purpose could be looked up and consumed for the other. `type` scopes each
// token to its purpose; only its hash is ever stored.
model VerificationToken {
  id        String                @id @default(uuid())
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@index([userId])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// Chat Module
// ─────────────────────────────────────────────

model Conversation {
  id            String             @id @default(uuid())
  status        ConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  application   JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String          @unique
  candidate     User            @relation("ConversationCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  recruiter     User            @relation("ConversationRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)
  recruiterId   String

  members  ConversationMember[]
  messages Message[]

  @@index([candidateId])
  @@index([recruiterId])
  @@map("conversations")
}

model ConversationMember {
  id             String              @id @default(uuid())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           ChatParticipantRole
  joinedAt       DateTime            @default(now())
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id              String       @id @default(uuid())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  String
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId        String
  content         String
  messageType     MessageType  @default(TEXT)
  clientMessageId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  attachments MessageAttachment[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  fileName  String
  fileUrl   String
  mimeType  String
  fileSize  Int
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}
